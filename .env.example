DATABASE_URL=postgresql://incys:local-development-only@127.0.0.1:5432/incys
APP_ORIGIN=http://localhost:3000
AUTH_MODE=local
DEMO_MODE=true
DEMO_PASSWORD=local-demo-only-change-me
# Production requires AUTH_MODE=firebase or supabase and DEMO_MODE=false.
# Public web settings default to config/firebase.web.json in production.
# Server-side Firebase Admin uses the Cloud Run service identity (ADC).
FIREBASE_PROJECT_ID=incys-institute
NEXT_PUBLIC_AUTH_MODE=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
ALLOWED_ORIGINS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VIDEO_PROVIDER=
GOOGLE_CLOUD_PROJECT=
GCS_PRIVATE_BUCKET=
CLAMAV_HOST=
CLAMAV_PORT=3310
SCAN_SERVICE_URL=
