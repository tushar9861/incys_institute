{
  "name": "incys-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:supabase": "node --env-file=.env.supabase.local scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "tsx --env-file=.env.local scripts/test.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "test:smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "cloud:preflight": "python3 scripts/deploy-gcp.py",
    "cloud:deploy": "python3 scripts/deploy-gcp.py --apply",
    "test:live": "node scripts/live-check.mjs",
    "format": "prettier --write app components lib server scripts tests",
    "format:check": "prettier --check app components lib server scripts tests",
    "test:scanner": "node --test tests/scanner.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "jose": "^6.2.18",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.37.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
